<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same as backup_rules.xml, for the Google
     account backup and for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
